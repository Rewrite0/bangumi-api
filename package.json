{
  "name": "bangumi-api-ts",
  "version": "4.0.0",
  "description": "用typescript包装的Bangumi REST API.",
  "keywords": [
    "bangumi",
    "api",
    "typescript"
  ],
  "homepage": "https://github.com/Rewrite0/bangumi-api#readme",
  "bugs": {
    "url": "https://github.com/Rewrite0/bangumi-api/issues",
    "email": "y747556795@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rewrite0/bangumi-api"
  },
  "license": "MIT",
  "author": {
    "name": "Rewrite0",
    "email": "y747556795@gmail.com"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./characters": {
      "import": "./dist/apis/characters/index.js",
      "types": "./dist/apis/characters/index.d.ts"
    },
    "./collections": {
      "import": "./dist/apis/collections/index.js",
      "types": "./dist/apis/collections/index.d.ts"
    },
    "./episodes": {
      "import": "./dist/apis/episodes/index.js",
      "types": "./dist/apis/episodes/index.d.ts"
    },
    "./indices": {
      "import": "./dist/apis/indices/index.js",
      "types": "./dist/apis/indices/index.d.ts"
    },
    "./persons": {
      "import": "./dist/apis/persons/index.js",
      "types": "./dist/apis/persons/index.d.ts"
    },
    "./revisions": {
      "import": "./dist/apis/revisions/index.js",
      "types": "./dist/apis/revisions/index.d.ts"
    },
    "./subjects": {
      "import": "./dist/apis/subjects/index.js",
      "types": "./dist/apis/subjects/index.d.ts"
    },
    "./users": {
      "import": "./dist/apis/users/index.js",
      "types": "./dist/apis/users/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "pull": "node scripts/pull.js",
    "push": "pnpm build && pnpm publish"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "openapi-typescript": "^7.10.1",
    "tsdown": "^0.15.9"
  }
}
